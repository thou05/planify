# ==============================================================================
# PLANIFY BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Application Port
PORT=4000
NODE_ENV=development

# ==============================================================================
# SUPABASE API CONFIGURATION (Không dùng trực tiếp PostgreSQL connection string)
# ==============================================================================
# Lấy từ Supabase Dashboard -> Project Settings -> API:
# 1. Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Project API Keys (anon public key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Project API Keys (service_role secret key - Dành cho Backend toàn quyền CRUD):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=planify_super_secret_jwt_key_2026_modern_kanban
JWT_EXPIRATION=7d

# ==============================================================================
# CORS ORIGIN
# ==============================================================================
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
